      <span className="material-symbols-outlined text-secondary" style={{ fontSize: 18 }}>icon_name</span>
    </div>
  </div>
  <div>
    <div className="text-display-lg font-display-lg text-on-background">42</div>
    <div className="flex items-center gap-1 mt-2 text-body-sm text-on-surface-variant">
